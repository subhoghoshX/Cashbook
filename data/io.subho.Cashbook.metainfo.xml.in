<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.subho.Cashbook</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <url type="homepage">https://github.com/subhoghoshX/Cashbook</url>
  <url type="bugtracker">https://github.com/subhoghoshX/Cashbook/issues</url>
  <url type="vcs-browser">https://github.com/subhoghoshX/Cashbook</url>

  <name>Cashbook</name>
  <summary>Record cash and bank transactions</summary>
  <description>
    <p>Cashbook records credit and debit transactions for separate cash or bank accounts. Search transaction details and see the current balance of each account.</p>
    <p>All data stays in a SQLite database inside a folder chosen by the user.</p>
  </description>

  <developer id="io.subho">
    <name>Subho</name>
  </developer>

  <translation type="gettext">cashbook</translation>
  <launchable type="desktop-id">io.subho.Cashbook.desktop</launchable>
  <content_rating type="oars-1.1" />

  <branding>
    <color type="primary" scheme_preference="light">#3584e4</color>
    <color type="primary" scheme_preference="dark">#1c71d8</color>
  </branding>

  <releases>
    <release version="0.1.1" date="2026-09-06">
      <description>
        <p>Replace the generic application icons with a green ledger and gold rupee coin, including a matching symbolic icon.</p>
      </description>
    </release>
    <release version="0.1.0" date="2026-09-05" />
  </releases>
</component>
