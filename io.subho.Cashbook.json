{
    "id" : "io.subho.Cashbook",
    "runtime" : "org.gnome.Platform",
    "runtime-version" : "50",
    "sdk" : "org.gnome.Sdk",
    "command" : "io.subho.Cashbook",
    "default-branch" : "stable",
    "finish-args" : [
        "--share=ipc",
        "--socket=fallback-x11",
        "--device=dri",
        "--socket=wayland"
    ],
    "cleanup" : [
        "/include",
        "/lib/pkgconfig",
        "/man",
        "/share/doc",
        "/share/gtk-doc",
        "/share/man",
        "/share/pkgconfig",
        "*.la",
        "*.a"
    ],
    "modules" : [
        {
            "name" : "cashbook",
            "builddir" : true,
            "buildsystem" : "meson",
            "run-tests" : true,
            "sources" : [
                {
                    "type" : "dir",
                    "path" : ".",
                    "skip" : [ ".git", ".flatpak-builder", "build", "build-flatpak", "build-dir", "repo", "dist" ]
                }
            ]
        }
    ]
}
